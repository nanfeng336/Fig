  #scale_fill_manual(#limits=c('Africa','Europe','North America','Oceania','South America','Asia','Asia.YZY','uncalculated'),         
  #values=c("#CFEAF1","#C4A5DE","#F27970","#96CCCB","#cc340c","#e4ce00","#32B897","#f18800"))+
  facet_wrap(. ~ group2) +
  geom_boxplot(aes(x = group3, y = Shannon, fill = group3), alpha = 1)+
  geom_jitter(aes(x =group2, y = Shannon), size = 0.8,alpha=0.2)+
