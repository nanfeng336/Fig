anova_LSD <- plot_data %>% 
  aov(Shannon ~ group1, data = .) %>% #使用aov函数对plot_data数据框进行方差分析，以Shannon作为响应变量，group2作为解释变量
  LSD.test(., "group1", group =T) %>% #对ANOVA的结果进行LSD多重比较测试
  .$group %>% 
  mutate(.,group1 = rownames(.)) %>%
  rename(.,markers = groups) %>%
  select(.,group1, markers, everything())  %>% 
  left_join(., alpha_max, by = 'group1') %>% 
  left_join(., alpha_sd, by = 'group1') %>% 
  select(.,group1, markers, contains("Shannon")) %>% 
  select(., !Shannon) %>% 
  replace(., is.na(.), 0)

anova_LSD1 <- plot_data %>% 
  aov(Richness ~ group1, data = .) %>% 
  LSD.test(., "group1", group =T) %>% 
  .$group %>% 
  mutate(.,group1 = rownames(.)) %>%
  rename(.,markers = groups) %>%
  select(.,group1, markers, everything())  %>% 
  left_join(., alpha_max, by = 'group1') %>% 
  left_join(., alpha_sd, by = 'group1') %>% 
  select(.,group1, markers, contains("Richness")) %>% 
  select(., !Richness) %>% 
  replace(., is.na(.), 0)

