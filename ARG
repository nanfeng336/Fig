group<-fread("group.txt")
plot_data <- read.delim("ARG-alpha.txt", sep = '\t', stringsAsFactors = FALSE, check.names = FALSE) %>% 
  select(.,Shannon,Richness,sample) %>% 
  left_join(.,group,by='sample')

#dunn'test   LSD   字母abc



alpha_max <- plot_data %>% 
  group_by(group1)  %>% 
  summarise(.,across(where(is.numeric),max)) %>% 
  ungroup()  %>% 
  rename_at(.,vars(!group1),function(x) paste0(x,"_max"))


alpha_sd <- plot_data %>% 
  group_by(group1) %>% 
  summarise(.,across(where(is.numeric),sd)) %>% 
  ungroup()  %>%
  rename_at(.,vars(!group1),function(x) paste0(x,"_sd"))

